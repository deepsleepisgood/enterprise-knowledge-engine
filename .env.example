# Copy to .env and fill in. LLM_PROVIDER: nim (NVIDIA NIM), openai or anthropic.
LLM_PROVIDER=nim
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TIMEOUT_S=300
NIM_MAX_RPM=35
NIM_MAX_CONCURRENT=4
MODEL_SMART=nvidia/nemotron-3-ultra-550b-a55b
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# Scanned PDFs and images are read by a vision model (parser tier 3) only when this is set.
# Any image-capable model works; deepseek-v4.1-flash-1017-fast on Isoquant reads pages (14 Nov).
MODEL_VISION=

# Isoquant (OpenAI-compatible, keep LLM_PROVIDER=nim): NIM_BASE_URL=https://api.isoquant.ai/v1,
# MODEL_SMART=MODEL_FAST=deepseek-v4.1-flash-1017-fast
ISOQUANT_API_KEY=

# OpenAI (LLM_PROVIDER=openai): set MODEL_FAST and MODEL_SMART to OpenAI model ids, e.g.
# MODEL_FAST=gpt-5-mini, MODEL_SMART=gpt-5 (check the current model list on platform.openai.com).
# MODEL_VISION needs an image-capable model. MODEL_PRICES gives costs for the call log:
# MODEL_PRICES=gpt-5-mini=0.25/2.00,gpt-5=1.25/10.00   (USD per million tokens, input/output)
OPENAI_API_KEY=
OPENAI_MAX_RPM=500
OPENAI_MAX_CONCURRENT=8
# Minimum output budget for reasoning models (their hidden thinking uses it too); a cap, not a charge.
OPENAI_REASONING_MIN_TOKENS=16384
MODEL_PRICES=

# Anthropic (LLM_PROVIDER=anthropic): MODEL_FAST=claude-haiku-5-5, MODEL_SMART=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Local: `docker compose up -d db` gives the URL below.
# Without Docker: `python scripts/dev_db.py start` writes a URL that is used when this is empty.
DATABASE_URL=
API_BASE_URL=http://localhost:8000
BLOB_DIR=
TENANT_ID=default
SCHEMA_MODE=induced
PLUGINS=ap
