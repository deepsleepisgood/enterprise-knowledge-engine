# Copy to .env and fill in. LLM_PROVIDER: nim (NVIDIA NIM) or anthropic.
LLM_PROVIDER=nim
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TIMEOUT_S=300
NIM_MAX_RPM=35
NIM_MAX_CONCURRENT=4
MODEL_SMART=nvidia/nemotron-3-ultra-550b-a55b
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b

# Isoquant (OpenAI-compatible, keep LLM_PROVIDER=nim): NIM_BASE_URL=https://api.isoquant.ai/v1,
# MODEL_SMART=MODEL_FAST=deepseek-v4.1-flash-1017-fast
ISOQUANT_API_KEY=

# Anthropic (LLM_PROVIDER=anthropic): MODEL_FAST=claude-haiku-5-5, MODEL_SMART=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Local: `docker compose up -d db` gives the URL below.
# Without Docker: `python scripts/dev_db.py start` writes a URL that is used when this is empty.
DATABASE_URL=
API_BASE_URL=http://localhost:8000
BLOB_DIR=
TENANT_ID=default
SCHEMA_MODE=induced
PLUGINS=ap
