# Copy to .env and fill in. LLM_PROVIDER: nim (NVIDIA NIM) or anthropic.
LLM_PROVIDER=nim
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TIMEOUT_S=300
NIM_MAX_RPM=35
NIM_MAX_CONCURRENT=4
MODEL_SMART=nvidia/nemotron-3-ultra-550b-a55b
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# Scanned PDFs and images are read by a vision model (parser tier 3) only when this is set.
# Any image-capable model works; deepseek-v4.1-flash-1017-fast on Isoquant reads pages (14 Nov).
MODEL_VISION=

# Isoquant (OpenAI-compatible, keep LLM_PROVIDER=nim): NIM_BASE_URL=https://api.isoquant.ai/v1,
# MODEL_SMART=MODEL_FAST=deepseek-v4.1-flash-1017-fast
ISOQUANT_API_KEY=

# Anthropic (LLM_PROVIDER=anthropic): MODEL_FAST=claude-haiku-5-5, MODEL_SMART=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Local: `docker compose up -d db` gives the URL below.
# Without Docker: `python scripts/dev_db.py start` writes a URL that is used when this is empty.
DATABASE_URL=
API_BASE_URL=http://localhost:8000
BLOB_DIR=
TENANT_ID=default
SCHEMA_MODE=induced
PLUGINS=ap

# Digest delivery (optional). Each channel switches on once its settings are filled in;
# until then the Changes page offers "Copy as text" only.
# Email: any SMTP server (Microsoft 365: smtp.office365.com, Gmail: smtp.gmail.com with an
# app password). SMTP_SECURITY: starttls (port 587), ssl (port 465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_EMAIL_TO=
# Teams: in the channel, Workflows > "Post to a channel when a webhook request is received",
# then paste the workflow's URL here (keep it secret: anyone with it can post).
TEAMS_WEBHOOK_URL=
# Automatic daily send by the worker, "HH:MM" in the team's time zone (minutes east of UTC,
# e.g. 330 for India). Empty: send only with the "Send now" button.
DIGEST_SEND_AT=
DIGEST_UTC_OFFSET_MINUTES=0
DIGEST_SKIP_EMPTY=true
# Link back to the app in sent digests.
WEB_BASE_URL=
