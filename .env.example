# Copy to .env and fill in. LLM_PROVIDER: nim (NVIDIA NIM), openai or anthropic.
LLM_PROVIDER=nim
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TIMEOUT_S=300
NIM_MAX_RPM=35
NIM_MAX_CONCURRENT=4
MODEL_SMART=nvidia/nemotron-3-ultra-550b-a55b
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# Scanned PDFs and images are read by a vision model (parser tier 3) only when this is set.
# Any image-capable model works; deepseek-v4.1-flash-1017-fast on Isoquant reads pages (14 Nov).
MODEL_VISION=

# Isoquant (OpenAI-compatible, keep LLM_PROVIDER=nim): NIM_BASE_URL=https://api.isoquant.ai/v1,
# MODEL_SMART=MODEL_FAST=deepseek-v4.1-flash-1017-fast
ISOQUANT_API_KEY=

# OpenAI (LLM_PROVIDER=openai): set MODEL_FAST and MODEL_SMART to OpenAI model ids, e.g.
# MODEL_FAST=gpt-5-mini, MODEL_SMART=gpt-5 (check the current model list on platform.openai.com).
# MODEL_VISION needs an image-capable model. MODEL_PRICES gives costs for the call log:
# MODEL_PRICES=gpt-5-mini=0.25/2.00,gpt-5=1.25/10.00   (USD per million tokens, input/output)
OPENAI_API_KEY=
OPENAI_MAX_RPM=500
OPENAI_MAX_CONCURRENT=8
# Minimum output budget for reasoning models (their hidden thinking uses it too); a cap, not a charge.
OPENAI_REASONING_MIN_TOKENS=16384
# Thinking level sent when a step asks reasoning models to answer directly (the whole answer
# path does): minimal | low | medium. "minimal" falls back to "low" if a model refuses it.
OPENAI_REASONING_EFFORT_OFF=minimal
# Seconds before an OpenAI call is abandoned and retried.
OPENAI_TIMEOUT_S=120
MODEL_PRICES=

# Anthropic (LLM_PROVIDER=anthropic): MODEL_FAST=claude-haiku-5-5, MODEL_SMART=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# With LLM_PROVIDER=anthropic: calls at once per process (more wait their turn), and retries of a
# rate limit or overload (Retry-After is honoured). Fit them to the account's limits.
# ANTHROPIC_MAX_CONCURRENT=8
# ANTHROPIC_MAX_RETRIES=6
# ANTHROPIC_TIMEOUT_S=120

# Local: `docker compose up -d db` gives the URL below.
# Without Docker: `python scripts/dev_db.py start` writes a URL that is used when this is empty.
DATABASE_URL=
API_BASE_URL=http://localhost:8000
# BLOB_DIR=            # uploaded originals; empty or unset = data/blobs
TENANT_ID=default
SCHEMA_MODE=induced
PLUGINS=ap

# Digest delivery (optional). Each channel switches on once its settings are filled in;
# until then the Changes page offers "Copy as text" only.
# Email: any SMTP server (Microsoft 365: smtp.office365.com, Gmail: smtp.gmail.com with an
# app password). SMTP_SECURITY: starttls (port 587), ssl (port 465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_EMAIL_TO=
# Teams: in the channel, Workflows > "Post to a channel when a webhook request is received",
# then paste the workflow's URL here (keep it secret: anyone with it can post).
TEAMS_WEBHOOK_URL=
# Automatic daily send by the worker, "HH:MM" in the team's time zone (minutes east of UTC,
# e.g. 330 for India). Empty: send only with the "Send now" button.
DIGEST_SEND_AT=
DIGEST_UTC_OFFSET_MINUTES=0
DIGEST_SKIP_EMPTY=true
# Link back to the app in sent digests.
WEB_BASE_URL=

# Evaluation: the model that grades answers (empty = MODEL_SMART). Keep it the same across runs
# you compare, e.g. JUDGE_MODEL=gpt-5.
JUDGE_MODEL=
