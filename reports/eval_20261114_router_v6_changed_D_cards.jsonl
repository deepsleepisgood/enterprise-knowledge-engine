{"id": "Q088", "card": {"answer_id": "551", "kb_version": 49, "as_of": null, "superseded_since": null, "client": "Arvana Group", "route": "calculator:ap.price", "status": "answered", "rule": {"text": "No — the line cannot pass the price match, because the invoice unit price of ₹123 is higher than the PO unit price of ₹120 and the excess on the line is ₹15, which is more than the limit of ₹6. [1] A line passes only if the total excess is no more than the lower of 1% of the PO line value and ₹500; here 1% of the ₹600 PO line value is ₹6, which is lower than the ₹500 cap. [1] The line is therefore held with exception PRICE_VAR and sent to the buyer who raised the PO, and the buyer must either amend the PO or ask the supplier for a credit note. [1] In practice, the note to the buyer should name the line and item, give the invoice and PO unit prices and the excess, and ask for the PO to be amended or a credit note obtained. [2]", "citations": [{"n": 1, "passage_id": "6a3d60030fef8254dc43", "file": "PS-07_AP_SOP_v4.0_2026.docx", "short_label": "AP SOP v4.0 §4.2", "locator": "4.2", "section_title": "Price tolerance", "doc_type": "sop", "status": "current", "quote": "Where the invoice unit price is higher than the PO unit price, the line passes only if the total excess on that line is no more than the lower of 1% of the PO line value and ₹500."}, {"n": 2, "passage_id": "a1c5bb42d73893644924", "file": "PS-07_training_and_expert_transcripts.docx", "short_label": "Video 3 [03:10]", "locator": "Video 3 [03:10]", "section_title": "Working the exception queue", "doc_type": "training", "status": "current", "quote": "Please amend PO or get a credit note.' A bad note: 'price issue pls check'."}]}, "working": [{"label": "PO line value (₹120 × 5)", "value": "₹600"}, {"label": "Excess on line (₹3 × 5)", "value": "₹15"}, {"label": "1% of PO line value", "value": "₹6"}, {"label": "Cap", "value": "₹500"}, {"label": "Limit (lower of the two)", "value": "₹6"}, {"label": "Excess within limit?", "value": "No"}], "decision": "Hold the line — price variance above tolerance", "exception_code": "PRICE_VAR", "next_owner": "PO buyer (amend the PO or obtain a credit note)", "older_sources": [{"topic": "Price tolerance", "current_value": "₹500", "older_value": "₹1,000", "file": "PS-07_AP_SOP_v3.1_2023.docx", "locator": "AP SOP v3.1", "superseded_by": "AP SOP v4.0 §4.2", "superseded_on": "2026-04-01"}, {"topic": "Price tolerance", "current_value": "₹500", "older_value": "₹1,000", "file": "PS-07_desk_instructions_and_client_memos.docx", "locator": "Part F", "superseded_by": "AP SOP v4.0 §4.2", "superseded_on": "2026-04-01"}, {"topic": "Price tolerance", "current_value": "1%", "older_value": "2%", "file": "PS-07_AP_SOP_v3.1_2023.docx", "locator": "AP SOP v3.1", "superseded_by": "AP SOP v4.0 §4.2", "superseded_on": "2026-04-01"}, {"topic": "Price tolerance", "current_value": "1%", "older_value": "2%", "file": "PS-07_desk_instructions_and_client_memos.docx", "locator": "Part F", "superseded_by": "AP SOP v4.0 §4.2", "superseded_on": "2026-04-01"}], "expert_tip": null, "route_to": null, "entities": [{"id": "9cb1508079ee39e919a9", "name": "invoice", "type": "invoice"}], "related": ["What should the note to the PO buyer contain?", "Who clears a PRICE_VAR exception and what must they do?", "Does a lower invoice price than the PO price get accepted?"], "latency_ms": 31964, "diagnostics": {"timings_s": {"route": 0.09, "retrieve": 31.29, "calculator_inputs_wait": 0.0, "answer_and_check": 0.37, "attempts": 2}, "router": {"route": "calculator:ap.price", "client": "Arvana Group", "confidence": 0.9, "out_of_scope_reason": "", "role": "po_buyer", "as_of": null}, "retrieval": {"scorer": "rerank", "top_score": -1.9287068843841553, "passages": [["AP SOP v4.0 §4.2", "6a3d60030fef8254dc43", -1.929], ["AP SOP v4.0 §3.1", "1ad458bfeb9cc6dfb974", -5.473], ["Video 3 [03:10]", "a1c5bb42d73893644924", -5.611], ["Video 1 [04:30]", "732c3af92baad708588f", -5.667], ["Video 1 [00:45]", "d4c521