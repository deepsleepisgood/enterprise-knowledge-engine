{"id": "Q071", "card": {"answer_id": "544", "kb_version": 49, "as_of": null, "superseded_since": null, "client": "Arvana Group", "route": "calculator:ap.price", "status": "answered", "rule": {"text": "No — the line cannot pass the price match: the excess of ₹1,000 on the line is above the ₹500 limit, so the line is held with exception PRICE_VAR. [1] A line passes only if the total excess is no more than the lower of 1% of the PO line value and ₹500, and here the limit is ₹500. [1] The held line is sent to the buyer who raised the PO, and the buyer either amends the PO or asks the supplier for a credit note. [1]", "citations": [{"n": 1, "passage_id": "6a3d60030fef8254dc43", "file": "PS-07_AP_SOP_v4.0_2026.docx", "short_label": "AP SOP v4.0 §4.2", "locator": "4.2", "section_title": "Price tolerance", "doc_type": "sop", "status": "current", "quote": "the line passes only if the total excess on that line is no more than the lower of 1% of the PO line value and ₹500"}]}, "working": [{"label": "PO line value (₹120 × 500)", "value": "₹60,000"}, {"label": "Excess on line (₹2 × 500)", "value": "₹1,000"}, {"label": "1% of PO line value", "value": "₹600"}, {"label": "Cap", "value": "₹500"}, {"label": "Limit (lower of the two)", "value": "₹500"}, {"label": "Excess within limit?", "value": "No"}], "decision": "Hold the line — price variance above tolerance", "exception_code": "PRICE_VAR", "next_owner": "PO buyer (amend the PO or obtain a credit note)", "older_sources": [{"topic": "Price tolerance", "current_value": "₹500", "older_value": "₹1,000", "file": "PS-07_AP_SOP_v3.1_2023.docx", "locator": "AP SOP v3.1", "superseded_by": "AP SOP v4.0 §4.2", "superseded_on": "2026-04-01"}, {"topic": "Price tolerance", "current_value": "₹500", "older_value": "₹1,000", "file": "PS-07_desk_instructions_and_client_memos.docx", "locator": "Part F", "superseded_by": "AP SOP v4.0 §4.2", "superseded_on": "2026-04-01"}, {"topic": "Price tolerance", "current_value": "1%", "older_value": "2%", "file"