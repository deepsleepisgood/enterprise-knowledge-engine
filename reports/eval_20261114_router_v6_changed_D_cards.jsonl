{"id": "Q076", "card": {"answer_id": "545", "kb_version": 49, "as_of": null, "superseded_since": null, "client": "Arvana Group", "route": "calculator:ap.price", "status": "answered", "rule": {"text": "No — the line cannot pass the price match: the excess of ₹700 on the line is above the ₹500 limit, so the line is held with exception PRICE_VAR. [1] The rule is that where the invoice unit price is higher than the PO unit price, the line passes only if the total excess on that line is no more than the lower of 1% of the PO line value and ₹500. [1] A line that fails is sent to the buyer who raised the PO, and the buyer either amends the PO or asks the supplier for a credit note. [1]", "citations": [{"n": 1, "passage_id": "6a3d60030fef8254dc43", "file": "PS-07_AP_SOP_v4.0_2026.docx", "short_label": "AP SOP v4.0 §4.2", "locator": "4.2", "section_title": "Price tolerance", "doc_type": "sop", "status": "current", "quote": "the line passes only if the total excess on that line is no more than the lower of 1% of the PO line value and ₹500"}]}, "working": [{"label": "PO line value (₹640 × 100)", "value": "₹64,000"}, {"label": "Excess on line (₹7 × 100)", "value": "₹700"}, {"label": "1% of PO line value", "value": "₹640"}, {"label": "Cap", "value": "₹500"}, {"label": "Limit (lower of the two)", "value": "₹500"}, {"label": "Excess within limit?", "value": "No"}], "decision": "Hold the line — price variance above tolerance", "exception_code": "PRICE_VAR", "next_owner": "PO buyer (amend the PO or obtain a credit note)", "older_sources": [{"topic": "Price tolerance", "current_value": "₹500", "older_value": "₹1,000", "file": "PS-07_AP_SOP_v3.1_2023.docx", "locator": "AP SOP v3.1", "superseded_by": "AP SOP v4.0 §4.2", "superseded_on": "2026-04-01"}, {"topic": "Price tolerance", "current_value": "₹500", "older_value": "₹1,000", "file": "PS-07_desk_instructions_and_client_memos.docx", "locator": "Part F", "superseded_by": "AP SOP v4.0 §4.2", "superseded_on": "2026-04-01"}, {"topic": "Price tolerance", "current_value": "1%", "older_value": "2%", "file": "PS-07_AP_SOP_v3.1_2023.docx", "locator": "AP SOP v3.1", "superseded_by": "AP SOP v4.0 §4.2", "superseded_on": "2026-04-01"}, {"topic": "Price tolerance", "current_value": "1%", "older_value": "2%", "file": "PS-07_desk_instructions_and_client_memos.docx", "locator": "Part F", "superseded_by": "AP SOP v4.0 §4.2", "superseded_on": "2026-04-01"}], "expert_tip": null, "route_to": null, "entities": [{"id": "9cb1508079ee39e919a9", "name": "invoice", "type": "invoice"}], "related": ["What happens to the line once the PO buyer amends the PO?", "How is the 1% of PO line value calculated for a line?", "Does a lower invoice price than the PO price get accepted?"], "latency_ms": 12028, "diagnostics": {"timings_s": {"route": 0.03, "retrieve": 11.41, "calculator_inputs_wait": 0.0, "answer_and_check": 0.17, "attempts": 1}, "router": {"route": "calculator:ap.price", "client": "Arvana Group", "confidence": 0.9, "out_of_scope_reason": "", "role": "po_buyer", "as_of": null}, "retrieval": {"scorer": "rerank", "top_score": -1.5259511470794678, "passages": [["AP SOP v4.0 §4.2", "6a3d60030fef8254dc43", -1.526], ["AP SOP v4.0 §3.1", "1ad458bfeb9cc6dfb974", -5.617], ["Video 1 [00:45]", "d4c52159c378008a8480", -5.851], ["DI-03 Part A, step 4", "be14f644503dd76f141c", -6.211], ["Video 3 [03:10]", "a1c5bb42d73893644924", -6.965], ["AP SOP v4.0 §4.3", "650ec83794239ad8d60e", -6.966]], "facts": [627, 824, 330, 583, 227, 628, 447, 826, 653, 622]}, "calculator": {"family": "price", "inputs": {"po_unit_price": 640.0, "invoice_unit_price": 647.0, "quantity": 100.0, "client": "Arvana Group"}, "passed": false, "decision": "Hold the line — price variance above tolerance", "exception_code": "PRICE_VAR", "result": {"line_value": 64000.0, "excess": 700.0, "pct_limit": 640.0, "cap": 500.0, "limit": 500.0}}, "verifier": {"verified": true, "problems": [], "attempts": []}}}}
