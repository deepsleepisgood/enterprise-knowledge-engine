{"id": "Q047", "card": {"answer_id": "546", "kb_version": 49, "as_of": null, "superseded_since": null, "client": "Arvana Infra Projects", "route": "lookup", "status": "answered", "rule": {"text": "No — the invoice should be held as NO_GRN with the requester notified automatically, and you should not post it against the PO without a GRN whatever the requester says on the phone. [1] The system sends a reminder after two working days and escalates to the requester's manager after five working days, and the Requester owns resolution of NO_GRN with a target of 5 working days. [1][2] For Arvana Infra Projects, requesters must post GRNs within two working days of receipt. [3] In practice, Infra sites batch their GRNs on Monday morning, so anything that comes in Friday to Sunday is waited on until Tuesday noon rather than chased on Monday. [4][5]", "citations": [{"n": 1, "passage_id": "26bda74a5f1666174528", "file": "PS-07_AP_SOP_v4.0_2026.docx", "short_label": "AP SOP v4.0 §4.6", "locator": "4.6", "section_title": "Missing GRN", "doc_type": "sop", "status": "current", "quote": "If a goods invoice has no GRN, hold it as NO_GRN and notify the requester automatically."}, {"n": 2, "passage_id": "8bd7618f5d2bfc991f01", "file": "PS-07_AP_SOP_v4.0_2026.docx", "short_label": "AP SOP v4.0 §10", "locator": "10", "section_title": "Exceptions", "doc_type": "sop", "status": "current", "quote": "NO_GRN | Goods invoice without GRN (4.6) | Requester | 5 working days"}, {"n": 3, "passage_id": "502134b3a6eaf7905636", "file": "PS-07_desk_instructions_and_client_memos.docx", "short_label": "CM-INF-02 Part C", "locator": "Part C", "section_title": "Client memo CM-INF-02 (Arvana Infra Projects)", "doc_type": "memo", "status": "current", "quote": "Requesters are reminded to post GRNs within two working days of receipt."}, {"n": 4, "passage_id": "f67b136daa068ef58540", "file": "PS-07_training_and_expert_transcripts.docx", "short_label": "Expert interview 1 [02:30]", "locator": "Expert interview 1 [02:30]", "section_title": "Lakshmi Reddy, Senior Processor", "doc_type": "interview", "status": "record", "quote": "Infra sites batch their GRNs on Monday morning, so anything that comes in Friday to Sunday, I wait until Tuesday noon."}, {"n": 5, "passage_id": "78ece007c6a3b53d4491", "file": "PS-07_training_and_expert_transcripts.docx", "short_label": "Shadowing notes 10:05", "locator": "Shadowing notes 10:05", "section_title": "a day with a senior processor", "doc_type": "observation", "status": "record", "quote": "Says Infra sites post GRNs in a batch on Monday mornings, so she waits until Tuesday noon."}]}, "working": null, "decision": "No — hold as NO_GRN; wait until Tuesday noon before chasing", "exception_code": null, "next_owner": null, "older_sources": [{"topic": "GRN posting timeline", "current_value": "automatically notify requester", "older_value": "held and requester e-mailed", "file": "PS-07_AP_SOP_v3.1_2023.docx", "locator": "AP SOP v3.1", "superseded_by": "AP SOP v4.0 §4.6", "superseded_on": "2026-04-01"}, {"topic": "Quantity tolerance", "current_value": "specific_materials", "older_value": "client-specific bulk materials (Arvana Infra Projects per CM-INF-02)", "file": "PS-07_AP_SOP_v4.0_2026.docx", "locator": "AP SOP v4.0 §4.3", "superseded_by": "CM-INF-02 Part C", "superseded_on": "2026-04-15"}, {"topic": "Quantity tolerance", "current_value": "specific_materials", "older_value": "specific materials (Infra bulk materials per client memo)", "file": "PS-07_training_and_expert_transcripts.docx", "locator": "Video 1 [06:55]", "superseded_by": "CM-INF-02 Part C", "superseded_on": "2026-04-15"}, {"topic": "quantity_tolerance.infra_material_percentage", "current_value": "5%", "older_value": "10%", "file": "PS-07_desk_instructions_and_client_memos.docx", "locator": "Part F", "superseded_by": "CM-INF-02 Part C", "superseded_on": "2026-04-15", "reason": "Part F, dated 09 Oct 2023 is stale; CM-INF-02 Part C, dated 15 Apr 2026 is current (for Arvana Infra Projects)."}], "expert_tip": {"text": "Infra sites batch their GRNs on Monday morning.", "author": "Lakshmi", "date": "2026-09-08", "citation": {"n": 0, "passage_id": "f67b136daa068ef58540", "file": "PS-07_training_and_expert_transcripts.docx", "short_label": "Expert interview 1 [02:30]", "locator": "Expert interview 1 [02:30]", "section_title": "Lakshmi Reddy, Senior Processor", "doc_type": "interview", "status": "record", "quote": "Infra sites batch their GRNs on Monday morning, so anything that comes in Friday to Sunday, I wait until Tuesday noon."}, "approved_by": null}, "route_to": null, "entities": [{"id": "ffe6f9529e43bb88d336", "name": "GRN", "type": "goodsreceiptnote"}, {"id": "9cb1508079ee39e919a9", "name": "invoice", "type": "invoice"}, {"id": "1c9d1c9d362d8457f549", "name": "Infra", "type": "topic"}, {"id": "3c48bf158368b68c6997", "name": "Infra", "type": "material"}, {"id": "a27b2b274ad9e579ca36", "name": "NO_GRN", "type": "exceptioncode"}], "related": ["What happens if the GRN still isn't posted after five working days?", "Who clears a NO_GRN exception for Arvana Infra Projects?", "Does the two-working-day GRN reminder apply to all clients or only Arvana Infra Projects?"], "latency_ms": 18316, "diagnostics": {"timings_s": {"route": 0.03, "retrieve": 17.77, "answer_and_check": 0.13, "attempts": 1}, "router": {"route": "lookup", "client": "Arvana Infra Projects", "confidence": 0.82, "out_of_scope_reason": "", "role": "requester", "as_of": null}, "retrieval": {"scorer": "rerank", "top_score": 3.5898847579956055, "passages": [["Expert interview 1 [02:30]", "f67b136daa068ef58540", 3.59], ["Shadowing notes 10:05", "78ece007c6a3b53d4491", 2.877], ["AP SOP v4.0 §4.6", "26bda74a5f1666174528", -0.849], ["Video 3 [05:45]", "36fcb4fd337181b87cec", -1.916], ["AP SOP v4.0 §10", "8bd7618f5d2bfc991f01", -3.694], ["CM-INF-02 Part C", "502134b3a6eaf7905636", -5.045]], "facts": [602, 603, 574, 97, 857, 601, 553, 132, 538, 552]}, "verifier": {"verified": true, "problems": []